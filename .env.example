# Copy to .env.local and fill in. Never commit real values.

# --- Database -------------------------------------------------------------
# Required by /api/evolution-waitlist. Without it that route returns 500.
MONGODB_URI=
# Optional, defaults to "hersteam".
MONGODB_DB=hersteam

# --- SMTP -----------------------------------------------------------------
SERVICE=
EMAIL_PORT=465

# Juliet's mailbox: /api/contact, /api/newsletters, /api/booking
EMAIL_USER=
EMAIL_PASS=
RECEIVER=

# Her STEAM mailbox: /api/join, /api/join-wift, /api/donate, /api/evolution-waitlist
STEAM_EMAIL_USER=
STEAM_EMAIL_PASS=

# --- Google Form mirror ---------------------------------------------------
# Optional. Copies /api/evolution-waitlist registrations into the linked
# response sheet. Leave unset to disable the mirror; the route is unaffected.
# The ID is from the live form URL: /forms/d/e/<FORM_ID>/viewform
EVOLUTION_GOOGLE_FORM_ID=
